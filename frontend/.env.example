# Copie para .env.local. Variaveis SEM NEXT_PUBLIC_ ficam no servidor do
# Next e nunca entram no bundle do navegador.

# Backend que o proxy /api vai chamar.
FALANGE_BACKEND_URL=http://127.0.0.1:8010

# Token exigido pelo backend. Precisa bater com API_TOKEN do .env da raiz.
# Nao use NEXT_PUBLIC_ aqui: isso vazaria o segredo para quem abrir a pagina.
FALANGE_API_TOKEN=
