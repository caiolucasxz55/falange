# Copie para .env e preencha. O .env nao vai pro git.
DATABASE_URL=postgresql+asyncpg://falange:SUA_SENHA@127.0.0.1:5432/falange

# Raiz permitida para gerar_tasks_a_partir_de_arquivo.
# Fora daqui a leitura e recusada (importa quando o SSE for exposto ao time).
FALANGE_DOCS_ROOT=.

# Acima de quantas tasks abertas uma pessoa/bloco e considerado sobrecarregado.
LIMITE_SOBRECARGA=5

# URL do backend, usada pelos servidores MCP.
BACKEND_URL=http://127.0.0.1:8000

# Senha do Postgres no docker-compose.
POSTGRES_PASSWORD=falange

# Bind do servidor MCP SSE (0.0.0.0 dentro de container).
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8765
