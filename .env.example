# Copie para .env e preencha. O .env nao vai pro git.
DATABASE_URL=postgresql+asyncpg://falange:SUA_SENHA@127.0.0.1:5432/falange

# Raiz permitida para gerar_tasks_a_partir_de_arquivo.
# Fora daqui a leitura e recusada (importa quando o SSE for exposto ao time).
FALANGE_DOCS_ROOT=.

# Acima de quantas tasks abertas uma pessoa/bloco e considerado sobrecarregado.
LIMITE_SOBRECARGA=5

# URL do backend, usada pelos servidores MCP.
BACKEND_URL=http://127.0.0.1:8000

# Senha do Postgres no docker-compose.
POSTGRES_PASSWORD=falange

# Bind do servidor MCP SSE (0.0.0.0 dentro de container).
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8765

# Origens liberadas no CORS do backend (JSON). O frontend Next roda na 3010.
CORS_ORIGINS=["http://localhost:3010"]

# Segredo exigido pela API do backend. Vazio = porta aberta (so dev local).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Segredo exigido pelo servidor MCP SSE, que e a porta exposta ao time.
# Use um valor DIFERENTE do API_TOKEN.
SSE_TOKEN=

# Teto de requisicoes por cliente por minuto. 0 desliga.
LIMITE_POR_MINUTO=300

# Assina o access token do login. Vazio = login desligado. Pelo menos 32
# caracteres: HMAC-SHA256 com chave curta e fraca (RFC 7518). Trocar este
# valor desloga todo mundo.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SEGREDO=

# Validade do access token, em minutos. Curta de proposito.
JWT_MINUTOS=15

# Validade do refresh, em dias. Passado isso, login de novo.
SESSAO_DIAS=14

# true exige login em toda chamada. false (padrao) trata quem chega com o
# API_TOKEN e sem o header do MCP como admin sem login -- a transicao, ate a
# tela ter login.
EXIGIR_LOGIN=false
